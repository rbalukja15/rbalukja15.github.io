---
// Headline chosen by Romarjo. The accent half is deliberately the claim he can back:
// the isolation is proven by tests, not asserted. Mirrored on the OG card and in the
// meta description — change all three together.
// U+2011 non-breaking hyphen: without it the line breaks after "multi-", splitting the word.
const headlineLead = 'I build multi\u2011tenant systems and';
const headlineAccent = 'prove they hold';
---
<section id="hero" class="section">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="section-label">Multi-tenant B2B SaaS &middot; Access control</p>
      <h1>
        {headlineLead} <em>{headlineAccent}</em>.
      </h1>
      <p class="intro">
        Senior engineer, 7+ years. I build B2B SaaS where tenant isolation and access
        control are enforced at every layer — the ORM, Postgres row-level security, and
        the API on top. Remote from Albania.
      </p>
      <div class="actions">
        <a class="primary" href="/#projects">See the work</a>
        <a class="secondary" href="/Romarjo_Balukja_CV.pdf" target="_blank" rel="noopener">
          Download CV
        </a>
      </div>
    </div>
    <figure class="hero-shot">
      <img
        src="/images/tenantiq/ask-hero.webp"
        srcset="/images/tenantiq/ask-hero-640.webp 640w, /images/tenantiq/ask-hero-900.webp 900w, /images/tenantiq/ask-hero.webp 1200w"
        sizes="(max-width: 820px) 92vw, (max-width: 1080px) 55vw, 547px"
        width="1200"
        height="573"
        decoding="async"
        fetchpriority="high"
        alt="The TenantIQ ask screen: a question, a streamed answer with numbered citation markers, and a side panel showing the source passages those markers point to."
      />
      <figcaption>
        TenantIQ — every answer scoped to one workspace, every claim carrying the passage
        it came from.
      </figcaption>
    </figure>
  </div>
  <!--
    These four figures are published claims and must stay reproducible from a clone.
    Counted 2026-08-26 from ~/Desktop/tenantiq @ main. These move FAST — tenantiq gained
    30 backend tests and 2 ADRs in six days. Re-measure before any republish; do not trust
    this comment.
      692 = 407 backend test functions (backend/tests) + 285 frontend test cases (frontend/tests)
      19  = docs/adr/*.md excluding 0000-template.md
      2   = the scoped ORM manager and Postgres row-level security
      1   = vetapp, in daily production
    Re-measure before changing them; see Task 8 of the redesign plan.
  -->
  <div class="evidence">
    <div class="container evidence-row">
      <span>692 automated tests</span>
      <span>19 architecture decision records</span>
      <span>2 independent isolation layers</span>
      <span>1 system in daily production</span>
    </div>
  </div>
</section>

<style>
  #hero {
    padding-top: 3.5rem;
    padding-bottom: 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 3rem;
    align-items: center;
  }
  h1 {
    font-size: clamp(2.1rem, 5vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-bottom: 1.1rem;
  }
  h1 em {
    font-style: italic;
    color: var(--accent);
  }
  .intro {
    color: var(--ink-soft);
    max-width: 32rem;
    margin-bottom: 1.6rem;
  }
  .actions {
    display: flex;
    gap: 1.3rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .primary {
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.75rem 1.35rem;
    border-radius: 3px;
  }
  .secondary {
    color: var(--accent);
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hero-shot {
    margin: 0;
  }
  .hero-shot img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    box-shadow: var(--shadow-hover);
  }
  .hero-shot figcaption {
    color: var(--ink-faint);
    font-size: 0.78rem;
    font-style: italic;
    line-height: 1.5;
    margin-top: 0.7rem;
  }
  .evidence {
    border-top: 1px solid var(--border);
    margin-top: 3.5rem;
    background: var(--surface-alt);
  }
  /* These four spans sit on a flex-wrap boundary at <=900px. That used to cause an
     intermittent CLS when JetBrains Mono swapped in and changed their widths. The mono
     stack is system-only now, which removed that swap; a smaller intermittent shift from
     the remaining webfonts survives, well inside budget. Do not reintroduce a mono webfont. */
  .evidence-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.8rem;
    padding-top: 0.95rem;
    padding-bottom: 0.95rem;
    color: var(--ink-faint);
    font-size: 0.78rem;
  }
  .evidence-row span:first-child {
    color: var(--accent);
  }
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
